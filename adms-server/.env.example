# Shared Gajianich PostgreSQL; replace password and database name.
DATABASE_URL=postgresql://gajianich_app:REPLACE_ME@postgres:5432/gajianich_prod_db
# Existing Docker network containing PostgreSQL: docker network ls
GAJIANICH_DB_NETWORK=gajianich-live_default
# Set a LAN IP reachable from the machine after configuring its source allowlist.
ADMS_BIND_ADDRESS=127.0.0.1
ADMS_PORT=8081
ADMS_TIMEZONE_HOURS=7
MAX_BODY_BYTES=1048576
