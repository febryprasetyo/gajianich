PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gajianich_dev_db
JWT_SECRET=replace-with-a-secure-random-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-secure-random-refresh-secret-min-32-chars
AGENT_API_KEY=replace-with-a-secure-random-agent-key-min-32-chars

# Migration owner connection (separate from the unprivileged application DATABASE_URL).
# MIGRATION_DATABASE_URL=postgresql://migration_owner:...@localhost:5432/gajianich_dev_db
# Required when applying the HR audit migration: existing unprivileged runtime DB role.
# HR_AUDIT_RUNTIME_ROLE=gajianich_app
# Explicit disposable loopback database for HR audit integration tests; never production.
# HR_AUDIT_TEST_DATABASE_URL=postgresql://postgres:...@127.0.0.1:5432/gajianich_hr_audit_test

# Persistent GA screenshot directory. Include this directory in backups.
GA_STORAGE_DIR=./data/ga-evidence
