# GAJIANICH Production Environment Template
# Note: Generate unique random secrets for production (e.g., using `openssl rand -hex 32`)
APP_VERSION=v1.0.0
GHCR_OWNER=fastpec
DATABASE_URL=postgresql://gajianich_app:generate-strong-prod-password-min-16-chars@host.docker.internal:5432/gajianich_prod_db
JWT_SECRET=generate-random-secret-min-32-chars-via-openssl-rand-hex-32
JWT_REFRESH_SECRET=generate-different-random-secret-min-32-chars-via-openssl-rand-hex-32
AGENT_API_KEY=generate-agent-api-key-min-32-chars-via-openssl-rand-hex-32
ACCURATE_LICENSE_SERVER_URL=http://192.168.10.160:6688
CORS_ALLOWED_ORIGINS=https://gajianich.example.com

# Only passed to one-off migration containers through compose.migrate.yml.
# Provision the runtime login separately; it must not own audit tables.
MIGRATION_DATABASE_URL=postgresql://gajianich_migrator:generate-separate-owner-password@host.docker.internal:5432/gajianich_prod_db
HR_AUDIT_RUNTIME_ROLE=gajianich_app
