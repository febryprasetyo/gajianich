[Unit]
Description=AMS Production PostgreSQL Backup Integrity Verification
After=postgresql.service ams-postgres-backup.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
ExecStart=/opt/gajianich/deploy/scripts/verify-postgres-backup.sh /var/backups/gajianich/postgres
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
