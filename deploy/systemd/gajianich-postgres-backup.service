[Unit]
Description=GAJIANICH Production PostgreSQL Daily Backup
After=postgresql.service
Requires=postgresql.service

[Service]
Type=oneshot
User=postgres
ExecStart=/opt/gajianich/deploy/scripts/backup-postgres.sh /var/backups/gajianich/postgres gajianich_prod_db
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
