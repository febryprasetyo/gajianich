{
  "name": "gajianich-root",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -k -n \"backend,frontend\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "dev:up": "docker compose -f compose.dev.yml up -d",
    "dev:down": "docker compose -f compose.dev.yml down",
    "dev:logs": "docker compose -f compose.dev.yml logs -f",
    "dev:check": "bash scripts/validate-compose.sh dev",
    "prod:init": "bash deploy/scripts/lan-production.sh init",
    "prod:release": "bash deploy/scripts/lan-production.sh release",
    "prod:status": "bash deploy/scripts/lan-production.sh status",
    "prod:logs": "bash deploy/scripts/lan-production.sh logs",
    "prod:backup": "bash deploy/scripts/lan-production.sh backup",
    "prod:stop": "bash deploy/scripts/lan-production.sh stop",
    "prod:start": "bash deploy/scripts/lan-production.sh start",
    "deploy:prod": "bash deploy/scripts/deploy-to-prod.sh deploy",
    "prod:remote:status": "bash deploy/scripts/deploy-to-prod.sh status",
    "prod:remote:logs": "bash deploy/scripts/deploy-to-prod.sh logs",
    "prod:remote:backup": "bash deploy/scripts/deploy-to-prod.sh backup",
    "ci": "npm run dev:check && bash scripts/validate-compose.sh prod && npm test --prefix backend && npm run build --prefix backend && npm test --prefix frontend && npm run lint --prefix frontend && npm run build --prefix frontend"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.3",
    "bats": "^1.13.0",
    "concurrently": "^8.2.2",
    "shellcheck": "^4.1.0"
  }
}
