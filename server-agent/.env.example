# GAJIANICH Server360 Telemetry Hub Endpoint
GAJIANICH_HUB_URL=http://127.0.0.1:5000/api/v1/infrastructure/agent/telemetry

# Per-Server Unique Agent API Key (generated from GAJIANICH Server360 Registration Modal)
AGENT_API_KEY=gjn_srv_your_hostname_unique_key

# Server Identity & Topology Metadata
AGENT_HOSTNAME=srv-prod-node-01
AGENT_DISPLAY_NAME=srv-prod-node-01 (Host Server)
AGENT_SERVER_TYPE=Physical
AGENT_ROLE_BADGE=ON-PREMISE HOST
AGENT_PROVIDER=On-Premise Baremetal / Cloud VPS
AGENT_LOCATION=Jakarta DC-1
AGENT_ENVIRONMENT=Production

# Telemetry Push Interval (milliseconds, minimum 3000)
AGENT_INTERVAL_MS=5000

# Systemd Units to Monitor (comma-separated)
AGENT_SYSTEMD_UNITS=docker.service,ssh.service,containerd.service,NetworkManager.service,cron.service,ufw.service,systemd-resolved.service,systemd-journald.service

